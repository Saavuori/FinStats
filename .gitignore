# OS
.DS_Store
Thumbs.db

# Editors
.vscode/*
!.vscode/extensions.json
.idea

# Local Claude Code settings (launch.json is tracked; local settings are not)
.claude/settings.local.json

# Node
frontend/node_modules
frontend/dist

# Go build output
*.exe
*.exe~
*.test
*.out
backend/finstats

# Frontend build embedded into the binary at image-build time; only the
# .gitkeep placeholder is tracked so //go:embed all:dist compiles in a checkout.
backend/internal/api/dist/*
!backend/internal/api/dist/.gitkeep

# Env / secrets
.env
.env.*
!.env.example

# Generated changelog site
/dist-changelog
